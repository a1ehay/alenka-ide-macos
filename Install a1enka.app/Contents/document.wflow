				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run AppleScript.action</string>
				<key>ActionName</key>
				<string>Запустить AppleScript</string>
				<key>ActionParameters</key>
				<dict>
					<key>source</key>
					<string>try
    -- 1. Показываем приветственное окно
    set userChoice to button returned of (display dialog "Добро пожаловать в a1enka!

Этот установщик автоматически:
• Установит Node.js и Ollama
• Скачает локальную нейросеть (~1 ГБ)
• Создаст удобное приложение в строке меню

Для установки потребуются права администратора (пароль).

Продолжить?" buttons {"Отмена", "Установить"} default button "Установить" with icon 1)
    
    if userChoice is "Отмена" then
        return
    end if

    -- 2. Находим папку, в которой лежит этот установщик
    tell application "Finder"
        set appPath to (path to me) as text
        set folderPath to (container of (appPath as alias)) as text
    end tell
    
    -- 3. Формируем путь к тихому скрипту установки
    set shPath to POSIX path of folderPath &amp; "silent-install.sh"
    
    -- 4. Запускаем скрипт с правами администратора (тут macOS попросит пароль)
    do shell script "chmod +x " &amp; quoted form of shPath &amp; " &amp;&amp; " &amp; quoted form of shPath with administrator privileges
    
on error errMsg
    -- Если что-то пошло не так, показываем понятную ошибку
    display dialog "Произошла ошибка при установке:

" &amp; errMsg buttons {"OK"} default button 1 with icon stop
end try</string>
				</dict>
